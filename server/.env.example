# 复制为 .env 后按需修改（切勿提交到版本库）
# 启动： node --env-file=.env server.js      （Node >= 20.6）

# ---- 服务 ----
PORT=8787
# 前端经 Nginx 终止 HTTPS 时设为 1，cookie 才会带 Secure
COOKIE_SECURE=0

# ---- 会话 ----
SESSION_HOURS=8
IDLE_MINUTES=60

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vpnapp
DB_PASS=change_me_to_a_strong_password
DB_NAME=vpn_ctrl
DB_POOL=10

# ---- 初始化 ----
# 超级管理员初始口令（≥10 位，含大小写与数字）。
# 留空 = 不预设口令，首次打开平台会引导你在网页上设置（推荐）。
ADMIN_INIT_PWD=
# 是否写入演示数据（目的地 / VPN 用户 / 访问日志）。
# 注意：SEED_DEMO=1 会额外创建 3 个演示账号（zhangwei / lijing / wangqiang），
#      生产环境请保持 0。
SEED_DEMO=0

# ---- 网关日志采集推送口令 ----
# 网关侧采集器 POST /api/ingest 时需带 X-Ingest-Token；
# 网关侧 vpn-sync 拉取 /api/gateway/peers 与 /api/gateway/grants 时也用同一口令。
INGEST_TOKEN=change_me_random_token

# ---- WireGuard 落地模式 ----
# agent（默认）：平台只提供接口，网关上的 vpn-sync 拉取后自行落地（推荐，平台无需特权）
# local        ：平台就装在网关本机，直接写 wg0.conf 并 `wg syncconf`（需平台以 root 运行）
WG_MODE=agent
# local 模式下的接口名与配置文件路径
WG_IFACE=wg0
WG_CONF=/etc/wireguard/wg0.conf

# ---- WireGuard 私钥加密主密钥 ----
# 用于 AES-256-GCM 加密落库的 peer 私钥。留空则用 server/.wgkey 文件派生（首次自动生成）。
# 生产建议显式设置并妥善备份：一旦丢失，历史私钥将无法解密。
WG_KEY_SECRET=

# ---- 下发给客户端的配置文件要素（生成 /api/vpn/:id/conf 时用）----
# 网关公钥（可用 WG_SERVER_PUB 直接指定，或把网关公钥写入 server.pub）
WG_SERVER_PUB=
# 客户端连接端点，形如 vpn.example.com:51820
WG_ENDPOINT=
# 客户端 MTU / DNS / 允许路由
WG_CLIENT_MTU=1280
WG_CLIENT_DNS=
WG_CLIENT_ALLOWED=10.100.0.0/24, 10.0.0.0/8
