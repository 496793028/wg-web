# 复制为 .env 后按需修改（切勿提交到版本库）
# 启动： node --env-file=.env server.js      （Node >= 20.6）

# ---- 服务 ----
PORT=8787
# 前端经 Nginx 终止 HTTPS 时设为 1，cookie 才会带 Secure
COOKIE_SECURE=0

# ---- 会话 ----
SESSION_HOURS=8
IDLE_MINUTES=60

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vpnapp
DB_PASS=change_me_to_a_strong_password
DB_NAME=vpn_ctrl
DB_POOL=10

# ---- 初始化 ----
# 超级管理员初始口令（≥10 位，含大小写与数字）。
# 留空 = 不预设口令，首次打开平台会引导你在网页上设置（推荐）。
ADMIN_INIT_PWD=
# 是否写入演示数据（目的地 / VPN 用户 / 访问日志）。
# 注意：SEED_DEMO=1 会额外创建 3 个演示账号（zhangwei / lijing / wangqiang），
#      生产环境请保持 0。
SEED_DEMO=0

# ---- 网关日志采集推送口令 ----
# 网关侧采集器 POST /api/ingest 时需带 X-Ingest-Token
INGEST_TOKEN=change_me_random_token
