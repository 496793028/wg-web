# vpn-sync 配置模板 —— 复制为 /etc/vpn-sync.env 并 chmod 600
# 与平台 server/.env 中的 INGEST_TOKEN 保持一致（网关拉取 peers/grants 用同一凭据）

# 平台地址（网关需能访问；建议走内网 / 或 HTTPS）
VPN_BASE=https://vpn.example.com
# 共享密钥（与平台 INGEST_TOKEN 相同，务必随机、保密）
INGEST_TOKEN=请替换为强随机串

# WireGuard 接口名与配置文件路径
WG_IFACE=wg0
WG_CONF=/etc/wireguard/wg0.conf

# 同步间隔（秒）
VPN_SYNC_INTERVAL=30

# 状态目录（写 ip2name.json 供日志采集器使用）
VPN_SYNC_STATE=/var/lib/vpn-sync

# nftables 记账日志限速（防扫描型客户端刷爆 syslog）；留空=不限速
# 例：VPN_LOG_LIMIT=50/second
VPN_LOG_LIMIT=
