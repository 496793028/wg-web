# ============ VPN 权限管控平台 · 环境变量 ============
# 复制为 .env 后按实际环境修改；start.bat / start.sh 会自动加载（无需 dotenv 依赖）。
# 也可在系统环境变量 / systemd / 容器 env 中直接设置，效果相同。

# ---- 服务端口 ----
PORT=8787

# ---- MySQL 连接 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=vpn_ctrl
DB_POOL=10

# ---- 初始管理员口令（仅 npm run init 首次建账号时使用）----
# 留空 = 不预设口令：首次打开平台会引导你在网页上设置（推荐，也是默认行为）。
# 若在此填写，请务必换成自己的强口令（≥10 位，含大小写字母与数字）。
ADMIN_INIT_PWD=

# ---- 会话策略 ----
SESSION_HOURS=8
IDLE_MINUTES=60

# ---- Cookie 安全：生产环境经反向代理启用 HTTPS 后改为 1 ----
COOKIE_SECURE=0

# ---- 网关日志采集 token：生产环境务必设置；网关推送 /api/ingest 需带 x-ingest-token ----
INGEST_TOKEN=

# ---- 演示数据：置 1 则 npm run init 写入示例 IP-端口 / 包 / 用户 / 访问日志 ----
SEED_DEMO=0

# ---- WireGuard 对接 ----
# 落地模式：agent=网关上跑 vpn-sync 拉取（默认，Web 无需 root）
#           local=平台就在网关本机，直接写 wg0.conf 并 wg syncconf（需 root）
WG_MODE=agent
# 私钥加密主密钥（强烈建议设置；不设则首次运行生成 server/.wgkey，务必备份该文件）
WG_KEY_SECRET=

# 客户端配置文件所需（"查看/下载配置"功能依赖）
WG_ENDPOINT=vpn.example.com:51820
# 网关公钥；留空则自动读取 wg0.conf 同目录下的 server.pub
WG_SERVER_PUB=
# ⚠️ 隧道内 DNS：仅黑名单 / 全代理模式（AllowedIPs 含 0.0.0.0/0）会注入到客户端 conf。
#    必须填隧道可达的公共解析（如 223.5.5.5,119.29.29.29），否则全量模式下本机 DNS 查询
#    进隧道后被网关默认拒绝，表现为"握手成功但所有域名解析失败"。白名单模式不受影响。
WG_CLIENT_DNS=223.5.5.5,119.29.29.29
WG_CLIENT_ALLOWED=10.100.0.0/24, 10.0.0.0/8
WG_CLIENT_MTU=1280

# 仅 WG_MODE=local 时需要
WG_CONF=/etc/wireguard/wg0.conf
WG_IFACE=wg0
