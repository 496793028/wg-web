# =====================================================================
#  VPN 权限管控平台 — 提交忽略规则
#  原则：真实凭证、运行时数据、依赖、构建产物一律不入库
# =====================================================================

# ---- 环境变量文件（含数据库口令 / INGEST_TOKEN / WG_KEY_SECRET）----
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# ---- WireGuard 私钥加密主密钥（丢失将导致历史私钥无法解密）----
server/.wgkey
*.wgkey

# ---- 运行时数据：用户上传的头像 ----
# 注意用 /* 而非目录本身：忽略整个目录后 git 不会进入其中，! 反选将失效
server/uploads/*
!server/uploads/.gitkeep

# ---- 运行时数据：SQLite 库文件（DB_DRIVER=sqlite 时产生）----
server/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ---- 依赖 ----
node_modules/
server/node_modules/

# ---- 日志与调试产物 ----
*.log
npm-debug.log*
yarn-error.log*
_srv.log

# ---- 归档 / 发布包（可由源码重新生成，且可能裹入敏感文件）----
*.tar.gz
*.tgz
*.rar
*.zip
*.7z

# ---- 编辑器 / 操作系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Python 临时产物（手册内嵌脚本校验时产生）----
__pycache__/
*.pyc
_pychk.py
_wgcheck.py

# ---- 无头浏览器 UI 校验产物（截图 / html 桩，验证完即弃）----
_uicheck_*
_scr_*

# ---- 真机验证记录（含真实内网 IP，严禁入库；README 仅作本地引用）----
#   sanitize 脱敏后可移除本行再 git add verify/ 入库
verify/

# ---- 本地备份快照（仅供回滚参考，不入库；需要时从 tag 恢复）----
backup/
